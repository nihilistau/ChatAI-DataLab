{
  "hash_algorithm": "sha256",
  "retain_checkpoints": 10,
  "backup_root": ".project_integrity/backups",
  "manifest_path": ".project_integrity/index.json",
  "checkpoint_dir": ".project_integrity/checkpoints",
  "include_globs": ["**/*"],
  "exclude_globs": [
    ".git/**",
    "**/.venv/**",
    "**/venv/**",
    "**/.venv_corrupt/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.ipynb_checkpoints/**",
    ".project_integrity/**",
    "backups/**",
    "release_artifacts/**",
    "relay/frontend/dist/**",
    "relay/frontend/storybook-static/**",
    "relay/frontend/storybook-static-relay/**",
    "relay/frontend/storybook-static-playground/**",
    "**/*.tsbuildinfo",
    "**/*.pyc"
  ],
  "default_tags": ["integrity"],
  "default_milestone": "rolling",
  "notes": "Edit this file to change hashing behavior or exclusions."
}
